# ==========================================
# OPERATIONAL MODE (Master Switch)
# ==========================================
# Mode selection: paper | shadow | live
TRADING_MODE=paper

# Live execution arm state (REQUIRED for real orders in live mode)
LIVE_TRADING_ARMED=false

# ==========================================
# SERVER & LOGGING
# ==========================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ==========================================
# MARKET DATA & EXCHANGE CREDENTIALS
# ==========================================
# Binance (Primary market data)
BINANCE_ENV=mainnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CoinDCX (Fallback market data + Live execution venue)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ==========================================
# TELEGRAM ALERTS & NOTIFICATIONS
# ==========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_LEVEL=INFO

# ==========================================
# OLLAMA AI AGENTS (Local & Cloud Multi-Account)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gemma4:cloud
# Optional: Up to 3 Cloud Free API Keys for failover / rate-limit pooling
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=

# ==========================================
# AGENTIC LAYER — web search, tools, memory, reflection
# (feature/agentic-upgrade; all OFF by default)
# ==========================================
# --- Tool framework (MCP-style read-only tools) -------------------------
# When true, the TradingAgentsPipeline analyst stage is given a ToolRegistry
# and may invoke bounded, schema-validated, read-only tools before forming its
# report.
AGENT_TOOLS_ENABLED=false
AGENT_TOOLS_MAX_ITERATIONS=5
AGENT_TOOLS_TIMEOUT_MS=15000
AGENT_TOOLS_TOTAL_OUTPUT_TOKENS=4000

# --- Web search provider ------------------------------------------------
# 'free' uses CoinGecko + alternative.me + Binance public endpoints (no key).
# 'brave' uses Brave Search API (set AGENT_WEB_SEARCH_BRAVE_KEY).
AGENT_WEB_SEARCH_PROVIDER=free
AGENT_WEB_SEARCH_BRAVE_KEY=
AGENT_WEB_SEARCH_RATE_PER_MIN=8

# --- Agent memory (reflections + lessons) -------------------------------
# When true, closing fills trigger a reflection prompt whose structured output
# is persisted to data/agent_memory.sqlite3. Top-K lessons are re-injected
# into the next analyst prompt as ctx.agentMemory.
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_DB_PATH=data/agent_memory.sqlite3
AGENT_MEMORY_INJECT_TOP_K=5
AGENT_MEMORY_PRUNE_MS=7776000000
AGENT_MEMORY_LESSON_DECAY_FLOOR=0.05
AGENT_MEMORY_REFLECT_TIMEOUT_MS=30000

# --- Strategy parameter learner (per-strategy per-regime Q-learning) ---
AGENT_PARAM_LEARNING_ENABLED=false
AGENT_PARAM_LEARNING_ALPHA=0.1
AGENT_PARAM_LEARNING_GAMMA=0.9
AGENT_PARAM_LEARNING_EPSILON=0.1
AGENT_PARAM_LEARNING_MIN_TRADES=5

# --- Strategy selector (per-regime promotion) --------------------------
AGENT_STRATEGY_SELECTOR_ENABLED=false
AGENT_STRATEGY_SELECTOR_MIN_TRADES=10

# --- A/B testing framework ---------------------------------------------
AGENT_AB_TESTING_ENABLED=false
AGENT_AB_TESTING_INSTANCES=2
AGENT_AB_TESTING_WINDOW_TRADES=50
AGENT_AB_TESTING_EVAL_INTERVAL_MS=3600000

# ==========================================
# API SECURITY
# ==========================================
# When set, control endpoints (orders, kill switch, mode, quarantine release)
# require Authorization: Bearer <key> or x-api-key. Minimum 16 chars.
API_KEY=
# When set, POST /api/v1/mode/arm requires a matching passcode in the body.
LIVE_ARM_PASSCODE=

# ==========================================
# PROFIT GOALS (opt-in)
# ==========================================
# When enabled, hitting a target throttles risk or halts trading, and the
# state survives restarts (<data>/profit_goals.json).
PROFIT_GOALS_ENABLED=false
PROFIT_GOAL_DAILY_TARGET_PCT=0.02
PROFIT_GOAL_WEEKLY_TARGET_PCT=0.08
PROFIT_GOAL_MONTHLY_TARGET_PCT=0.2
# REDUCE_RISK | STOP_TRADING | TRAIL_STOPS
PROFIT_GOAL_ACTION=REDUCE_RISK
PROFIT_GOAL_RISK_REDUCTION_FACTOR=0.5
PROFIT_GOAL_COOLDOWN_MS=3600000
PROFIT_GOAL_ENABLE_DAILY=true
PROFIT_GOAL_ENABLE_WEEKLY=true
PROFIT_GOAL_ENABLE_MONTHLY=false

# ==========================================
# TRAILING STOPS (opt-in)
# ==========================================
# Cancels and replaces resting reduce-only STOP_MARKET orders as price moves
# in favour. Driven from the aggTrade stream.
TRAILING_STOPS_ENABLED=false
TRAILING_ACTIVATION_PCT=0.02
TRAILING_DISTANCE_PCT=0.015
TRAILING_BREAKEVEN_PCT=0.01
TRAILING_TP_EXTENSION_PCT=0.03

# ==========================================
# STRATEGY PERFORMANCE FEEDBACK (opt-in)
# ==========================================
# When false the tracker records stats but never quarantines a strategy.
STRATEGY_FEEDBACK_ENABLED=false
STRATEGY_FEEDBACK_MIN_TRADES=20
STRATEGY_FEEDBACK_MAX_DRAWDOWN_USDT=500
STRATEGY_FEEDBACK_MIN_WIN_RATE=0.3

# ==========================================
# AUTONOMOUS TRADING AGENT (DEFAULT: ENABLED)
# ==========================================
# `pnpm start` boots the engine in fully autonomous mode by default. The
# agent runs on its own clock (AUTONOMOUS_CYCLE_MS, default 30s) — independent
# of Binance candle-close events — and surveys every configured symbol's MTF
# stack, detects FORMING + READY setups, aligns HTF regime with MTF setup with
# LTF trigger, builds regime-adjusted trade plans, and submits signals through
# the same StrategyEngine pipeline regular strategies use.
#
# Opt-out (rare): set AUTONOMOUS_AGENT_ENABLED=false for the legacy candle-
# driven-only behaviour. Equivalent: `pnpm paper:candle-only` (which sets
# this env var for you). Useful to debug the strategy fleet in isolation.
AUTONOMOUS_AGENT_ENABLED=true
AUTONOMOUS_CYCLE_MS=30000
AUTONOMOUS_MIN_CONFLUENCE=65
AUTONOMOUS_MIN_RR=1.5
AUTONOMOUS_MAX_OPEN_POSITIONS=3
AUTONOMOUS_PER_SYMBOL_MAX_POSITIONS=1
AUTONOMOUS_COOLDOWN_MS=300000
AUTONOMOUS_REGIME_CONFIRMATION_BARS=3
AUTONOMOUS_MIN_CONFIDENCE=0.55
AUTONOMOUS_STRATEGY_ID=autonomous-agent

# --- Self-preservation: circuit breaker ----------------------------------
# Trip the agent (stop submitting new entries) when any of these breach.
# Existing positions are still managed by their stops/targets/trailing logic.
AUTONOMOUS_CB_MAX_DAILY_LOSS_PCT=0.03
AUTONOMOUS_CB_MAX_CONSECUTIVE_LOSSES=5
AUTONOMOUS_CB_MAX_DRAWDOWN_PCT=0.08
AUTONOMOUS_CB_COOLDOWN_MS=900000
AUTONOMOUS_CB_REQUIRE_HEALTHY_MARKET=true

# --- Learning loop: adaptive risk parameters -----------------------------
# Nudges the regime-overlay riskMultiplier toward the realised win rate of
# the last N closed trades. Min sample avoids small-sample knee-jerks.
AUTONOMOUS_LEARN_WINDOW_SIZE=30
AUTONOMOUS_LEARN_MIN_SAMPLE=5
AUTONOMOUS_LEARN_RISK_ADAPT_STEP=0.1
AUTONOMOUS_LEARN_RISK_MULT_MIN=0.5
AUTONOMOUS_LEARN_RISK_MULT_MAX=1.5

# --- Exit manager: intra-position decisions ------------------------------
# Flatten a position whose regime has flipped against it, even before the
# trailing stop fires. Also: emergency exit if unrealised loss exceeds the
# configured fraction of equity (0 disables that specific guard).
AUTONOMOUS_EXIT_ON_REGIME_FLIP=true
AUTONOMOUS_EXIT_MAX_UNREALIZED_LOSS_PCT=0.02

# --- Position scaling: pyramid adds + downside de-risk ---------------------
# SCALE_IN (pyramid into winners): when an open position is profitable by at
# least AUTONOMOUS_SCALE_IN_MIN_PROFIT_PCT of equity AND a fresh aligned READY
# setup confirms the move, add AUTONOMOUS_SCALE_IN_SIZE_FRACTION of the
# current position size (each add carries its own SL/TP). Bounded by
# AUTONOMOUS_SCALE_IN_MAX_ADDS per position + AUTONOMOUS_SCALE_IN_COOLDOWN_MS.
# SCALE_OUT (de-risk losers): when unrealized loss reaches
# AUTONOMOUS_SCALE_OUT_TRIGGER_PCT of equity (but is still below the full-breach
# AUTONOMOUS_EXIT_MAX_UNREALIZED_LOSS_PCT), close AUTONOMOUS_SCALE_OUT_CLOSE_
# FRACTION of the position once — cut exposure before the stop fires.
AUTONOMOUS_SCALING_ENABLED=true
AUTONOMOUS_SCALE_IN_MIN_PROFIT_PCT=0.01
AUTONOMOUS_SCALE_IN_SIZE_FRACTION=0.5
AUTONOMOUS_SCALE_IN_MAX_ADDS=1
AUTONOMOUS_SCALE_IN_COOLDOWN_MS=900000
AUTONOMOUS_SCALE_OUT_TRIGGER_PCT=0.01
AUTONOMOUS_SCALE_OUT_CLOSE_FRACTION=0.5

# --- Symbol lock: multi-strategy orchestration ------------------------------
# When enabled (default), the first strategy whose OPEN signal is accepted
# owns that symbol's entry rights for SYMBOL_LOCK_TTL_MS — the autonomous
# agent and candle-driven strategies (e.g. smc-agent) can never race each
# other into conflicting entries on the same symbol. CLOSE/CANCEL_ALL
# signals always pass (reducing risk is never blocked).
SYMBOL_LOCK_ENABLED=true
SYMBOL_LOCK_TTL_MS=300000

# --- LLM veto: debate consultation (AUTONOMY_AUDIT Finding 1) --------------
# When enabled (default), every entry candidate faces the same bull/bear
# debate the SMC strategy uses (analyst -> bull vs bear -> judge -> trader).
# A GENUINE NEUTRAL / opposing trader verdict vetoes the entry (durable
# AUTONOMOUS_LLM_VETO event). If any debate stage falls back (Ollama down,
# timeout), the consultation is "degraded" and NEVER vetoes — the agent
# falls back to its deterministic confidence and keeps trading.
AUTONOMOUS_LLM_VETO_ENABLED=true

# --- Weighted HTF alignment (AUTONOMY_AUDIT Finding 5) ---------------------
# Scale a setup's confluence by how strongly the 4h trend supports the
# direction, instead of the legacy binary pass/fail gate:
#   aligned = x1.0 | 4h RANGE/UNKNOWN = x0.7 | counter-trend = x0.3
#   (reversal archetypes countering the 4h trend get the x0.7 range weight)
# The weighted score must clear AUTONOMOUS_MIN_CONFLUENCE. Set the weighted
# flag to false to restore the legacy binary gate.
AUTONOMOUS_HTF_ALIGNMENT_WEIGHTED=true
AUTONOMOUS_HTF_RANGE_WEIGHT=0.7
AUTONOMOUS_HTF_COUNTER_WEIGHT=0.3

# --- Correlation-aware portfolio risk (AUTONOMY_AUDIT Finding 8) -----------
# Cap the margin-weighted exposure a candidate may ADD to its correlated
# cluster: same-direction open positions whose rolling 1h-return Pearson
# correlation with the candidate clears AUTONOMOUS_CORRELATION_FLOOR.
# Blocks the "BTC + ETH + SOL all long" concentration that the count-based
# AUTONOMOUS_MAX_OPEN_POSITIONS gate can't see. Hedges (opposite direction
# or negative correlation) are never counted.
AUTONOMOUS_CORRELATION_ENABLED=true
AUTONOMOUS_CORRELATION_FLOOR=0.7
AUTONOMOUS_CORRELATION_MAX_EXPOSURE_PCT=0.25
AUTONOMOUS_CORRELATION_LOOKBACK=50

# --- Health monitor: self-diagnostics ------------------------------------
AUTONOMOUS_HEALTH_STALE_MS=15000
AUTONOMOUS_HEALTH_MODEL_PROBE_INTERVAL_MS=300000

# --- Startup self-test ---------------------------------------------------
# Runs once at startup before the agent's first cycle. Verifies Ollama is
# reachable + all 5 brain modules (agent, breaker, health, perf, exit) +
# market data supervisor + broker equity are healthy. When true (default),
# CRITICAL failures halt the engine so the operator sees the problem
# immediately. Set to false to continue anyway (dev / debugging).
AUTONOMOUS_SELF_TEST_FAIL_ON_CRITICAL=true

# ==========================================
# SMC SETUP-ARCHETYPE PERFORMANCE FEEDBACK / SELF-LEARNING (opt-in)
# ==========================================
# Per-setup-type memory for smc-agent-v1 (e.g. SSL_SWEEP_REVERSAL_LONG).
# When false, stats still accumulate and feed the LLM's advisory setupMemory
# context, but a quarantined setup type is never blocked from trading.
SETUP_FEEDBACK_ENABLED=false
SETUP_FEEDBACK_MIN_TRADES=10
SETUP_FEEDBACK_MAX_DRAWDOWN_USDT=300
SETUP_FEEDBACK_MIN_WIN_RATE=0.3

# ==========================================
# SIMULATION & PERSISTENCE
# ==========================================
PAPER_STARTING_USDT=10000
DB_FILE=./data/paper.sqlite3
EVENT_LOG_FILE=./data/events.jsonl
SNAPSHOT_DIR=./data/snapshots
ANALYTICS_DIR=./data/analytics

# ==========================================
# TRADING UNIVERSE & TIMEFRAMES
# ==========================================
SYMBOLS=SOLUSDT,ETHUSDT,BTCUSDT
TIMEFRAMES=1m,5m,15m

# ==========================================
# STRATEGY TUNING
# ==========================================
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_RSI_UPPER=70
EMA_RSI_LOWER=30

BREAKOUT_LOOKBACK=20
BREAKOUT_ATR_STOP_MULT=2
BREAKOUT_ATR_TP_MULT=4

RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
RSI_NEUTRAL_HIGH=55
RSI_NEUTRAL_LOW=45