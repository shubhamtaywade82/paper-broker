# Server
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Binance (testnet defaults; set live keys for live data)
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Ollama (optional — used by ollama-trend-5m strategy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Paper account
PAPER_STARTING_USDT=10000

# Persistence
DB_FILE=./data/paper.sqlite3
EVENT_LOG_FILE=./data/events.jsonl
SNAPSHOT_DIR=./data/snapshots
ANALYTICS_DIR=./data/analytics

# Trading universe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAMES=5m,15m

# Strategy tuning (EMA trend)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_RSI_UPPER=70
EMA_RSI_LOWER=30

# Strategy tuning (breakout)
BREAKOUT_LOOKBACK=20
BREAKOUT_ATR_STOP_MULT=2
BREAKOUT_ATR_TP_MULT=4

# Strategy tuning (RSI mean reversion)
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
RSI_NEUTRAL_HIGH=55
RSI_NEUTRAL_LOW=45